---
import ThoughtFeed from '../../components/ThoughtFeed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FEED_CACHE_CONTROL, tagFeedResponse } from '../../lib/feed-cache';
import {
	getPageCount,
	getSortedThoughts,
	paginateThoughts,
} from '../../lib/thoughts';
import { getVoteCounts } from '../../lib/votes';

export const prerender = false;

const page = Number(Astro.params.page);

// Page 1 lives at `/`, so anything below 2 or non-numeric is not a real page.
if (!Number.isInteger(page) || page < 2) {
	return new Response('Not found', { status: 404 });
}

const allThoughts = await getSortedThoughts();
const pageCount = getPageCount(allThoughts.length);

if (page > pageCount) {
	return new Response('Not found', { status: 404 });
}

Astro.response.headers.set('Cache-Control', FEED_CACHE_CONTROL);
await tagFeedResponse();

const thoughts = paginateThoughts(allThoughts, page);
const votes = await getVoteCounts();
---

<BaseLayout title={`Page ${page} · Shubham's Thoughts`}>
	<ThoughtFeed thoughts={thoughts} votes={votes} page={page} pageCount={pageCount} />
</BaseLayout>
