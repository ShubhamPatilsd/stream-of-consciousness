---
import ThoughtFeed from '../components/ThoughtFeed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FEED_CACHE_CONTROL, tagFeedResponse } from '../lib/feed-cache';
import {
	getPageCount,
	getSortedThoughts,
	paginateThoughts,
} from '../lib/thoughts';
import { getVoteCounts } from '../lib/votes';

export const prerender = false;

Astro.response.headers.set('Cache-Control', FEED_CACHE_CONTROL);
await tagFeedResponse();

const [allThoughts, votes] = await Promise.all([
	getSortedThoughts(),
	getVoteCounts(),
]);
const pageCount = getPageCount(allThoughts.length);
const thoughts = paginateThoughts(allThoughts, 1);
---

<BaseLayout>
	<ThoughtFeed thoughts={thoughts} votes={votes} page={1} pageCount={pageCount} />
</BaseLayout>
