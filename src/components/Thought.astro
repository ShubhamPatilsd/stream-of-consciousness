---
import type { ThoughtRecord } from '../lib/thought-record';
import type { VoteCounts } from '../lib/votes';

interface Props {
	thought: ThoughtRecord;
	votes?: VoteCounts;
}

const { thought, votes = { up: 0, down: 0 } } = Astro.props;
const paragraphs = thought.text
	.split(/\n{2,}/)
	.map((paragraph) => paragraph.trim())
	.filter(Boolean);
const machineDate = thought.publishedAt.toISOString();
const readableDate = new Intl.DateTimeFormat('en-US', {
	dateStyle: 'long',
	timeStyle: 'short',
	timeZone: 'America/Los_Angeles',
}).format(thought.publishedAt);
---

<li class="thought-item">
	<article class="thought">
		<div class="thought-body">
			{
				paragraphs.map((paragraph) => (
					<p>
						{paragraph.split('\n').map((line, index) =>
							index === 0 ? (
								line
							) : (
								<>
									<br />
									{line}
								</>
							),
						)}
					</p>
				))
			}
		</div>
		<time datetime={machineDate}>{readableDate}</time>
		<form method="post" action="/api/vote" class="vote-form">
			<input type="hidden" name="thoughtId" value={thought.id} />
			<button type="submit" name="vote" value="up" aria-label="Upvote">
				▲ {votes.up}
			</button>
			<button type="submit" name="vote" value="down" aria-label="Downvote">
				▼ {votes.down}
			</button>
		</form>
	</article>
</li>
