---
import type { ThoughtRecord } from '../lib/thought-record';
import type { VoteCounts } from '../lib/votes';
import Thought from './Thought.astro';

interface Props {
	thoughts: ThoughtRecord[];
	votes: Map<string, VoteCounts>;
	page: number;
	pageCount: number;
}

const { thoughts, votes, page, pageCount } = Astro.props;
const newerHref = page === 2 ? '/' : `/page/${page - 1}/`;
const olderHref = `/page/${page + 1}/`;
---

<header class="site-header">
	<a href="/" class="site-title">Shubham's Thoughts</a>
</header>

<figure class="watercolor">
	<img
		src="/watercolor.jpg"
		alt="First Abstract Watercolor by Wassily Kandinsky"
		width="1024"
		height="784"
	/>
</figure>

<ol class="thought-list" aria-label="Thoughts">
	{thoughts.map((thought) => <Thought thought={thought} votes={votes.get(thought.id)} />)}
</ol>

{
	pageCount > 1 && (
		<nav class="pagination" aria-label="Thought pages">
			{page > 1 ? <a href={newerHref}>Newer</a> : <span />}
			<span aria-current="page">
				{page} of {pageCount}
			</span>
			{page < pageCount ? <a href={olderHref}>Older</a> : <span />}
		</nav>
	)
}
